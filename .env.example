# GeoView - Enhanced Configuration
# Copy this file to .env and fill in your actual credentials

# ===== Sentinel Hub (Automatic Satellite Image Fetching) =====
SENTINELHUB_CLIENT_ID=your-client-id-here
SENTINELHUB_CLIENT_SECRET=your-client-secret-here

# ===== Optional temporal land-cover analysis (Google Earth Engine) =====
EARTH_ENGINE_PROJECT=your-google-cloud-project-id

# ===== Email Configuration (OTP and Alerts) =====
ALERT_EMAIL=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-16-character-app-password
# Optional: destination for anomaly alert notifications. OTPs go to the
# account email entered on the login/recovery form, not to this address.
ALERT_RECEIVER_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ===== SMS Configuration (Optional - Twilio for OTP via SMS) =====
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+0987654321

# ===== Flask Configuration =====
SECRET_KEY=change-me-to-random-secret
FLASK_ENV=development
LOGIN_USERNAME=admin
LOGIN_PASSWORD=admin123

# ===== SETUP INSTRUCTIONS =====
# For Gmail (Email OTP):
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password in ALERT_EMAIL_PASSWORD
#
# For Twilio (SMS OTP):
# 1. Create account at https://www.twilio.com/
# 2. Get your Account SID and Auth Token from dashboard
# 3. Get verified phone numbers (FROM and TO)
#
# For Sentinel Hub (Auto Satellite Images):
# 1. Sign up at https://www.sentinel-hub.com/
# 2. Create OAuth credentials in account settings
# 3. Copy Client ID and Client Secret here
